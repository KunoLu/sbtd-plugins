{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:sbtd:revision-set:schema:1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "product_key", "repositories", "revision_set_id", "created_at", "status", "digest"],
  "properties": {
    "schema_version": { "const": 1 },
    "product_key": { "type": "string", "minLength": 1 },
    "revision_set_id": { "type": "string", "minLength": 1 },
    "created_at": { "type": "string", "format": "date-time" },
    "status": { "enum": ["ready", "partial", "blocked"] },
    "digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "repositories": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["repository_key", "requested_ref", "status"],
        "properties": {
          "repository_key": { "type": "string", "minLength": 1 },
          "requested_ref": { "type": "string", "minLength": 1 },
          "resolved_commit": { "type": "string", "pattern": "^[0-9a-f]{40,64}$" },
          "status": { "enum": ["resolved", "blocked", "unavailable"] },
          "error": { "type": "string" }
        }
      }
    }
  }
}
