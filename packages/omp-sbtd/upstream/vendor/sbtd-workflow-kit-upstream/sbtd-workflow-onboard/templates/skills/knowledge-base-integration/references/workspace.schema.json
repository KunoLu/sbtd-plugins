{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:sbtd:knowledge-workspace:schema:1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "product_key", "product_root", "paths", "runtime_root"],
  "properties": {
    "schema_version": { "const": 1 },
    "product_key": { "type": "string", "minLength": 1 },
    "product_root": { "type": "string", "pattern": "^/" },
    "paths": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": { "type": "string", "minLength": 1, "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$)).+$" }
    },
    "runtime_root": { "type": "string", "pattern": "^/" },
    "trust": {
      "type": "object",
      "additionalProperties": false,
      "required": ["deployment_metadata_roots", "allowed_issuers"],
      "properties": {
        "deployment_metadata_roots": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "pattern": "^/" }
        },
        "allowed_issuers": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        }
      }
    },
    "local_runner": { "$ref": "#/$defs/runnerAttestation" },
    "runners": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": ["adapter", "labels", "command"],
        "properties": {
          "adapter": { "const": "command" },
          "labels": {
            "type": "array",
            "uniqueItems": true,
            "items": { "type": "string", "minLength": 1 }
          },
          "command": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "string", "minLength": 1 }
          }
        }
      }
    }
  },
  "$defs": {
    "runnerAttestation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "version", "image_digest", "labels", "tools"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 1 },
        "image_digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
        "labels": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        },
        "tools": {
          "type": "object",
          "additionalProperties": { "type": "string", "minLength": 1 }
        }
      }
    }
  }
}
