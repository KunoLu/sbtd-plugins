{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:sbtd:deployment-manifest:schema:1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "repositories", "runners", "attestation"],
  "properties": {
    "schema_version": { "const": 1 },
    "environment": { "type": "string" },
    "repositories": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": { "type": "string", "pattern": "^[0-9a-f]{40,64}$" }
    },
    "runners": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": { "$ref": "#/$defs/runnerAttestation" }
    },
    "attestation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["issuer", "issued_at", "manifest_digest"],
      "properties": {
        "issuer": { "type": "string", "minLength": 1 },
        "issued_at": { "type": "string", "format": "date-time" },
        "manifest_digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" }
      }
    }
  },
  "$defs": {
    "runnerAttestation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "version", "image_digest", "labels", "tools"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 1 },
        "image_digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
        "labels": { "type": "array", "items": { "type": "string", "minLength": 1 } },
        "tools": { "type": "object", "additionalProperties": { "type": "string", "minLength": 1 } }
      }
    }
  }
}
