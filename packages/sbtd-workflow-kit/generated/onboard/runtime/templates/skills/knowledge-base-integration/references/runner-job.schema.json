{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:sbtd:runner-job:schema:1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "run_id", "suite_key", "attempt", "command_key", "repository", "revision_set", "command", "required_runner_labels", "artifact_dir"],
  "properties": {
    "schema_version": { "const": 1 },
    "run_id": { "type": "string", "minLength": 1 },
    "suite_key": { "type": "string", "minLength": 1 },
    "attempt": { "type": "integer", "minimum": 1 },
    "command_key": { "type": "string", "minLength": 1 },
    "repository": {
      "type": "object",
      "additionalProperties": false,
      "required": ["key", "remote", "requested_ref", "resolved_commit"],
      "properties": {
        "key": { "type": "string", "minLength": 1 },
        "remote": { "type": "string", "minLength": 1 },
        "requested_ref": { "type": "string", "minLength": 1 },
        "resolved_commit": { "type": "string", "pattern": "^[0-9a-f]{40,64}$" }
      }
    },
    "revision_set": { "type": "object" },
    "command": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
    "required_runner_labels": { "type": "array", "items": { "type": "string", "minLength": 1 } },
    "artifact_dir": { "type": "string", "pattern": "^/" }
  }
}
