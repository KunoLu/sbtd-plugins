{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:sbtd:validation-evidence:schema:1",
  "title": "Validation Evidence Envelope",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "runId",
    "createdAt",
    "evidenceSource",
    "trigger",
    "repository",
    "sourceRevision",
    "environmentAlignment",
    "e2eMode",
    "mockStrategy",
    "featureSources",
    "reports",
    "evidencePublication",
    "secretsRedacted"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "runId": { "type": "string", "minLength": 1 },
    "createdAt": { "type": "string", "format": "date-time" },
    "evidenceSource": { "enum": ["developer-local", "ci", "knowledge-server"] },
    "trigger": { "enum": ["local", "pre-pr", "pull-request", "merge", "schedule", "release", "manual"] },
    "repository": { "$ref": "#/$defs/repositoryRevision" },
    "sourceRevision": { "enum": ["exact", "dirty", "unknown"] },
    "environmentAlignment": { "enum": ["verified", "unverified", "mismatch", "not-needed"] },
    "e2eMode": { "enum": ["full-stack", "contract-backed", "mock-backed", "app-mocked", "smoke-only", "backend-only", "blocked", "not-needed"] },
    "mockStrategy": { "enum": ["none", "contract-backed", "user-approved", "blocked", "not-needed"] },
    "featureSources": {
      "type": "array",
      "items": { "$ref": "#/$defs/featureSource" }
    },
    "reports": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/report" }
    },
    "revisionSet": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/exactRepositoryRevision" }
    },
    "revisionSetId": { "type": "string", "minLength": 1 },
    "decisionId": { "type": "string", "minLength": 1 },
    "decisionDigest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "evidenceTargets": {
      "type": "array",
      "uniqueItems": true,
      "items": { "enum": ["pull-request", "knowledge-base"] }
    },
    "artifactManifest": { "type": "string", "minLength": 1 },
    "artifactManifestDigest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "checksumsFile": { "type": "string", "minLength": 1 },
    "runnerAttestations": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/runnerAttestation" }
    },
    "evidencePublication": { "enum": ["local-only", "published", "blocked", "not-configured"] },
    "secretsRedacted": { "type": "boolean" }
  },
  "allOf": [
    {
      "if": {
        "properties": { "evidenceSource": { "const": "knowledge-server" } },
        "required": ["evidenceSource"]
      },
      "then": {
        "required": ["revisionSet"],
        "properties": { "sourceRevision": { "const": "exact" } }
      }
    },
    {
      "if": {
        "properties": { "evidenceSource": { "const": "ci" } },
        "required": ["evidenceSource"]
      },
      "then": {
        "properties": {
          "sourceRevision": { "const": "exact" },
          "repository": {
            "properties": { "worktreeState": { "const": "clean" } }
          },
          "evidencePublication": {
            "enum": ["published", "blocked", "not-configured"]
          }
        }
      }
    },
    {
      "if": {
        "properties": { "sourceRevision": { "const": "dirty" } },
        "required": ["sourceRevision"]
      },
      "then": {
        "properties": {
          "repository": {
            "properties": { "worktreeState": { "const": "dirty" } }
          },
          "evidencePublication": { "const": "local-only" }
        }
      }
    },
    {
      "if": {
        "properties": { "sourceRevision": { "const": "exact" } },
        "required": ["sourceRevision"]
      },
      "then": {
        "properties": {
          "repository": {
            "properties": {
              "sourceCommit": { "type": "string", "pattern": "^[0-9a-fA-F]{40,64}$" },
              "worktreeState": { "const": "clean" }
            }
          }
        }
      }
    }
  ],
  "$defs": {
    "repositoryRevision": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repositoryKey", "sourceRef", "sourceCommit", "worktreeState"],
      "properties": {
        "repositoryKey": { "type": "string", "minLength": 1 },
        "sourceRef": { "type": "string", "minLength": 1 },
        "sourceCommit": {
          "oneOf": [
            { "type": "string", "pattern": "^[0-9a-fA-F]{40,64}$" },
            { "type": "null" }
          ]
        },
        "worktreeState": { "enum": ["clean", "dirty", "unknown"] }
      }
    },
    "exactRepositoryRevision": {
      "allOf": [
        { "$ref": "#/$defs/repositoryRevision" },
        {
          "properties": {
            "sourceCommit": { "type": "string", "pattern": "^[0-9a-fA-F]{40,64}$" },
            "worktreeState": { "const": "clean" }
          }
        }
      ]
    },
    "featureSource": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repositoryKey", "path", "sourceRef", "sourceCommit"],
      "properties": {
        "repositoryKey": { "type": "string", "minLength": 1 },
        "path": { "type": "string", "minLength": 1 },
        "feature": { "type": "string", "minLength": 1 },
        "rule": { "type": "string", "minLength": 1 },
        "scenario": { "type": "string", "minLength": 1 },
        "examplesFingerprint": { "type": "string", "minLength": 1 },
        "sourceRef": { "type": "string", "minLength": 1 },
        "sourceCommit": { "type": "string", "pattern": "^[0-9a-fA-F]{40,64}$" }
      }
    },
    "report": {
      "type": "object",
      "additionalProperties": false,
      "required": ["testType", "path", "summaryMd", "sha256", "status", "mode"],
      "properties": {
        "testType": { "enum": ["unit", "api", "web", "mobile", "hybrid"] },
        "path": { "type": "string", "minLength": 1 },
        "summaryMd": { "type": "string", "minLength": 1 },
        "sha256": { "type": "string", "pattern": "^[0-9a-fA-F]{64}$" },
        "status": { "enum": ["passed", "failed", "blocked", "skipped"] },
        "mode": { "enum": ["full-stack", "contract-backed", "mock-backed", "app-mocked", "smoke-only", "backend-only", "blocked", "not-needed"] }
      }
    },
    "runnerAttestation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "version", "image_digest", "labels", "tools"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 1 },
        "image_digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
        "labels": { "type": "array", "items": { "type": "string", "minLength": 1 } },
        "tools": { "type": "object", "additionalProperties": { "type": "string", "minLength": 1 } }
      }
    }
  }
}
