{
  "$schema": "https://biomejs.dev/schemas/2.3.15/schema.json",
  "files": {
    "includes": [
      "packages/**",
      "package.json",
      "tsconfig.base.json",
      "!!packages/**/dist",
      "!!packages/**/generated",
      "!!packages/**/generated-omp",
      "!!packages/**/generated-agent-plugin",
      "!!packages/**/vendor",
      "!!packages/omp-sbtd/kit",
      "!!packages/omp-sbtd/skills",
      "!!packages/omp-sbtd/SBOM.spdx.json",
      "!!packages/omp-sbtd/test/fixtures",
      "!!packages/omp-sbtd/validation/**/evidence"
    ]
  },
  "linter": {
    "enabled": true,
    "rules": {
      "recommended": true
    }
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space"
  }
}
